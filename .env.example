# 로컬 개발용으로 각 값을 채우세요. 실제 값이 든 .env는 커밋하지 않습니다.
POSTGRES_PASSWORD=
USERS_DB_PASSWORD=
COMPANY_DB_PASSWORD=
HUB_DB_PASSWORD=
ORDERS_DB_PASSWORD=
DELIVERY_DB_PASSWORD=
JWT_SECRET=
# 서비스 간 내부 API 인증값(X-Service-Token). 서비스마다 서로 다른 값을 사용합니다.
GATEWAY_SERVICE_TOKEN=
USERS_SERVICE_TOKEN=
ORDERS_SERVICE_TOKEN=
HUB_SERVICE_TOKEN=
COMPANY_SERVICE_TOKEN=
DELIVERY_SERVICE_TOKEN=
# local 프로필의 개발 계정 3개가 처음 생성될 때 사용하는 비밀번호입니다.
DEV_DATA_PASSWORD=

GATEWAY_PORT=8080
EUREKA_PORT=8761
ZIPKIN_PORT=9411
POSTGRES_PORT=5432

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
